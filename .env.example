# Copy to .env and fill in your own keys (never commit .env). Only the keys you use are needed.
# NVIDIA NIM (June endpoint; gpt-oss-20b re-collection): https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
# Alibaba Cloud Model Studio (Bailian): console -> API-KEY
DASHSCOPE_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# Only if the Bailian console shows a different (workspace-specific) base URL:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ModelScope access token (optional fallback): modelscope.cn -> account -> access token
MODELSCOPE_API_KEY=
# DeepSeek (optional, back-translation only): platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=
